<mxfile host="Electron" agent="zcode">
  <diagram id="abstract-v2" name="条件转化·抽象框架">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="TITLE" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="条件转化框架：可控条件内标定公式，超出可控条件外推" vertex="1">
          <mxGeometry height="32" width="1400" x="30" y="10" as="geometry" />
        </mxCell>

        <!-- ========== 上段：流程 ========== -->
        <mxCell id="IN_H" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#1F4E79;fontSize=12;fontStyle=1;align=center;" value="可控条件（输入）" vertex="1">
          <mxGeometry height="30" width="200" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="IN_B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FFFFFF;strokeColor=#1F4E79;fontSize=10;align=left;spacingLeft=8;" value="· 雨强 r（mm/h）&lt;br&gt;· 时段 / 星期 / 假日&lt;br&gt;· 温度（预留）" vertex="1">
          <mxGeometry height="70" width="200" x="40" y="96" as="geometry" />
        </mxCell>

        <mxCell id="BASE_H" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6E4F0;strokeColor=#1F4E79;fontSize=12;fontStyle=1;align=center;" value="晴天基线（四个分布）" vertex="1">
          <mxGeometry height="30" width="200" x="40" y="200" as="geometry" />
        </mxCell>
        <mxCell id="BASE_B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FFFFFF;strokeColor=#1F4E79;fontSize=10;align=left;spacingLeft=8;" value="· 出发时间 λ0(t)&lt;br&gt;· 空间 λ0(s)&lt;br&gt;· 距离 P0(d)&lt;br&gt;· 速度 P0(v|t)" vertex="1">
          <mxGeometry height="70" width="200" x="40" y="236" as="geometry" />
        </mxCell>

        <mxCell id="FIT_H" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;align=center;" value="标定：可控范围内拟合系数" vertex="1">
          <mxGeometry height="30" width="280" x="290" y="60" as="geometry" />
        </mxCell>
        <mxCell id="FIT_B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FFFFFF;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=8;" value="&lt;b&gt;用轻雨/中雨数据（可控范围内）&lt;/b&gt;&lt;br&gt;实测三个点：+8.6% / +12.9% / +21.7%&lt;br&gt;拟合公式：效应 = θ·ln(1+r/RC)&lt;br&gt;得到两个系数（θ 和 RC）" vertex="1">
          <mxGeometry height="70" width="280" x="290" y="96" as="geometry" />
        </mxCell>

        <mxCell id="EXT_H" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;align=center;" value="外推：超出可控范围代公式" vertex="1">
          <mxGeometry height="30" width="280" x="290" y="200" as="geometry" />
        </mxCell>
        <mxCell id="EXT_B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FFFFFF;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=8;" value="&lt;b&gt;暴雨 30mm/h（数据没见过）&lt;/b&gt;&lt;br&gt;代同一公式：+26%&lt;br&gt;附置信区间；方向正确（饱和约束）" vertex="1">
          <mxGeometry height="70" width="280" x="290" y="236" as="geometry" />
        </mxCell>

        <mxCell id="GEN_H" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;align=center;" value="生成：基线 × 系数" vertex="1">
          <mxGeometry height="30" width="260" x="620" y="60" as="geometry" />
        </mxCell>
        <mxCell id="GEN_B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FFFFFF;strokeColor=#82B366;fontSize=10;align=left;spacingLeft=8;" value="λ(t) × 系数&lt;br&gt;速度 × 折扣&lt;br&gt;距离 三参数&lt;br&gt;空间 ≈ 不动（雨）" vertex="1">
          <mxGeometry height="70" width="260" x="620" y="96" as="geometry" />
        </mxCell>

        <mxCell id="VER_H" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=center;" value="验证：盲测通过才放行" vertex="1">
          <mxGeometry height="30" width="260" x="620" y="200" as="geometry" />
        </mxCell>
        <mxCell id="VER_B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FFFFFF;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" value="生成 vs 真实雨天&lt;br&gt;λ(t) 误差 −76% ｜ KS=0.024&lt;br&gt;外推偏差 4%（强雨档）" vertex="1">
          <mxGeometry height="70" width="260" x="620" y="236" as="geometry" />
        </mxCell>

        <mxCell id="OUT_H" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;align=center;" value="输出：极端条件下的轨迹集" vertex="1">
          <mxGeometry height="30" width="280" x="930" y="60" as="geometry" />
        </mxCell>

        <!-- 流程箭头 -->
        <mxCell id="a1" edge="1" parent="1" style="html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=triangle;" source="IN_H" target="FIT_H">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" edge="1" parent="1" style="html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=triangle;" source="IN_B" target="BASE_H">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" edge="1" parent="1" style="html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=triangle;" source="FIT_H" target="EXT_H">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" edge="1" parent="1" style="html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=triangle;dashed=1;strokeColor=#9673a6;" source="VER_H" target="EXT_H">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" edge="1" parent="1" style="html=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=triangle;" source="EXT_H" target="GEN_H">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== 下段：外推示意图 ========== -->
        <mxCell id="EXH" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1F4E79;" value="外推示意：可控范围内标定曲线 → 超出范围沿公式延伸（不爆炸）" vertex="1">
          <mxGeometry height="28" width="1200" x="40" y="330" as="geometry" />
        </mxCell>
        <mxCell id="EXSEP" parent="1" style="rounded=0;fillColor=#BFBFBF;strokeColor=#BFBFBF;" value="" vertex="1">
          <mxGeometry height="1.5" width="1740" x="30" y="360" as="geometry" />
        </mxCell>

        <mxCell id="CHART_BG" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;" value="" vertex="1">
          <mxGeometry height="330" width="520" x="40" y="375" as="geometry" />
        </mxCell>
        <mxCell id="CHART_T" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=1;" value="可控范围（实测三个点）＋ 外推段（公式延伸）" vertex="1">
          <mxGeometry height="18" width="520" x="40" y="378" as="geometry" />
        </mxCell>

        <mxCell id="CH2_BG" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;" value="" vertex="1">
          <mxGeometry height="330" width="520" x="600" y="375" as="geometry" />
        </mxCell>
        <mxCell id="CH2_T" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=1;" value="同框架适配任意条件（换特征组合 = 换系数值）" vertex="1">
          <mxGeometry height="18" width="520" x="600" y="378" as="geometry" />
        </mxCell>

        <mxCell id="WHY_H" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F4E79;" value="三个保证（为什么这套框架能外推）" vertex="1">
          <mxGeometry height="26" width="600" x="1160" y="375" as="geometry" />
        </mxCell>
        <mxCell id="W1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;fontSize=10;align=left;spacingLeft=8;" value="&lt;b&gt;① 公式形式有物理约束&lt;/b&gt;&lt;br&gt;单调递增 + 增量饱和 → 外推不爆炸&lt;br&gt;6 种饱和公式互验：差异 &amp;lt; 3pp" vertex="1">
          <mxGeometry height="62" width="520" x="1160" y="405" as="geometry" />
        </mxCell>
        <mxCell id="W2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;fontSize=10;align=left;spacingLeft=8;" value="&lt;b&gt;② 系数用可观测数据标定&lt;/b&gt;&lt;br&gt;只需轻中雨数据（365 样本估 2 个系数）&lt;br&gt;盲测外推偏差仅 4%" vertex="1">
          <mxGeometry height="62" width="520" x="1160" y="470" as="geometry" />
        </mxCell>
        <mxCell id="W3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;fontSize=10;align=left;spacingLeft=8;" value="&lt;b&gt;③ 形状参数锁死&lt;/b&gt;&lt;br&gt;σ0 / α / 峰宽不随条件变（实测恒定）&lt;br&gt;跨年独立拟合全参数重合" vertex="1">
          <mxGeometry height="62" width="520" x="1160" y="535" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
