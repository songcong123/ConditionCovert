<mxfile host="Electron" agent="zcode">
  <diagram id="multivar-extrapolation" name="多变量外推示意">
    <mxGraphModel dx="1700" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="TITLE" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="多变量外推：从单变量曲线到多维条件空间" vertex="1">
          <mxGeometry height="32" width="1400" x="30" y="10" as="geometry" />
        </mxCell>
        <mxCell id="SUBT" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" value="单变量可控区→外推 = 1D 曲线延伸；多变量可控区→外推 = 高维空间的分层切片外推——原理相同，维度升高" vertex="1">
          <mxGeometry height="24" width="1400" x="30" y="44" as="geometry" />
        </mxCell>

        <mxCell id="SEP0" parent="1" style="rounded=0;fillColor=#BFBFBF;strokeColor=#BFBFBF;" value="" vertex="1">
          <mxGeometry height="2" width="1740" x="30" y="74" as="geometry" />
        </mxCell>

        <!-- ============ 上段：三步类比 ============ -->
        <mxCell id="T1H" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#1F4E79;" value="单变量（已验证）" vertex="1">
          <mxGeometry height="26" width="540" x="40" y="84" as="geometry" />
        </mxCell>
        <mxCell id="T2H" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#833C0B;" value="多变量（同一原理升维）" vertex="1">
          <mxGeometry height="26" width="540" x="620" y="84" as="geometry" />
        </mxCell>
        <mxCell id="T3H" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#375623;" value="落地实现（查表×公式，不用黑箱）" vertex="1">
          <mxGeometry height="26" width="540" x="1200" y="84" as="geometry" />
        </mxCell>

        <!-- ===== 列1: 单变量 ===== -->
        <mxCell id="S1A" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=D6E4F0;strokeColor=1F4E79;fontSize=10.5;align=left;spacingLeft=8;" value="&lt;b&gt;可控范围&lt;/b&gt;：轻雨/中雨实测&lt;br&gt;1 个轴（雨强 r）上标定 3 个点" vertex="1">
          <mxGeometry height="42" width="540" x="40" y="114" as="geometry" />
        </mxCell>
        <mxCell id="S1B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FFFFFF;strokeColor=1F4E79;fontSize=10.5;align=left;spacingLeft=8;" value="&lt;b&gt;拟合公式&lt;/b&gt;：θ·ln(1+r/RC) → 2 个系数" vertex="1">
          <mxGeometry height="42" width="540" x="40" y="162" as="geometry" />
        </mxCell>
        <mxCell id="S1C" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FFFFFF;strokeColor=1F4E79;fontSize=10.5;align=left;spacingLeft=8;" value="&lt;b&gt;外推&lt;/b&gt;：r &amp;gt; 实测范围 → 代公式延伸&lt;br&gt;盲测偏差 4% ✓" vertex="1">
          <mxGeometry height="42" width="540" x="40" y="210" as="geometry" />
        </mxCell>

        <!-- ===== 列2: 多变量 ===== -->
        <mxCell id="S2A" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FCE4D6;strokeColor=ED7D31;fontSize=10.5;align=left;spacingLeft=8;" value="&lt;b&gt;可控范围&lt;/b&gt;：多特征组合的实测格&lt;br&gt;特征轴升高：雨强 × 时段(5) × 日型(3) = 15 个格子&lt;br&gt;每格有实测效应值（可控范围内）" vertex="1">
          <mxGeometry height="42" width="540" x="620" y="114" as="geometry" />
        </mxCell>
        <mxCell id="S2B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FFFFFF;strokeColor=ED7D31;fontSize=10.5;align=left;spacingLeft=8;" value="&lt;b&gt;分层公式&lt;/b&gt;：全局 1 条曲线 × 每格 1 个修正比值 γ&lt;br&gt;γ = 该格实测均值 ÷ 全局公式预测值（直读，无拟合）" vertex="1">
          <mxGeometry height="42" width="540" x="620" y="162" as="geometry" />
        </mxCell>
        <mxCell id="S2C" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=FFFFFF;strokeColor=ED7D31;fontSize=10.5;align=left;spacingLeft=8;" value="&lt;b&gt;外推&lt;/b&gt;：某格雨强超出可控范围 → 全局曲线延伸 × 该格 γ&lt;br&gt;= 曲线形状不变（锁死）+ 修正系数直读" vertex="1">
          <mxGeometry height="42" width="540" x="620" y="210" as="geometry" />
        </mxCell>

        <!-- ===== 列3: 落地 ===== -->
        <mxCell id="S3A" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=E2F0D9;strokeColor=70AD47;fontSize=10.5;align=left;spacingLeft=8;" value="&lt;b&gt;全局公式&lt;/b&gt;（1 条）：θg·ln(1+r/RCg)&lt;br&gt;θg=0.023, RCg=0.02（365 样本拟合 2 系数）" vertex="1">
          <mxGeometry height="42" width="540" x="1200" y="114" as="geometry" />
        </mxCell>
        <mxCell id="S3B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=E2F0D9;strokeColor=70AD47;fontSize=10.5;align=left;spacingLeft=8;" value="&lt;b&gt;γ 查表&lt;/b&gt;（10 个数，实测直读）：&lt;br&gt;工作日 0.42/1.52/1.34/1.22/0.72&lt;br&gt;周末 0.53/1.04/1.61/1.40/(1.35)" vertex="1">
          <mxGeometry height="42" width="540" x="1200" y="162" as="geometry" />
