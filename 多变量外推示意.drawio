        <mxCell id="S3C" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=E2F0D9;strokeColor=70AD47;fontSize=10.5;align=left;spacingLeft=8;" value="&lt;b&gt;最终&lt;/b&gt;：效应 = 全局公式 × γ(时段,日型)&lt;br&gt;外推 MAE = 10.7pp &amp;lt; 自然波动 13.9pp ✓" vertex="1">
          <mxGeometry height="42" width="540" x="1200" y="210" as="geometry" />
        </mxCell>

