        <mxCell id="C3a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82B366;fontSize=10;align=left;spacingLeft=6;" value="&lt;b&gt;三套基线表切换&lt;/b&gt;&lt;br&gt;工作日：7×24（通勤三峰）&lt;br&gt;周末：夜生活型（23时大）&lt;br&gt;假日：−5.6% + 峰位后移7~10时" vertex="1">
          <mxGeometry height="52" width="280" x="700" y="244" as="geometry" />
        </mxCell>
        <mxCell id="C3b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;align=left;spacingLeft=6;dashed=1;" value="关键规则：禁用日总量缩放（单日异质性）；&lt;br&gt;假日下雨不叠加（差0.7pp）→ 换基线即可" vertex="1">
          <mxGeometry height="36" width="280" x="700" y="300" as="geometry" />
        </mxCell>

        <mxCell id="C4H" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ed7d31;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" value="事件查表（叠加在日型之上）" vertex="1">
          <mxGeometry height="30" width="280" x="1020" y="118" as="geometry" />
        </mxCell>
        <mxCell id="C4a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ed7d31;fontSize=9;align=left;spacingLeft=4;" value="&lt;b&gt;球赛/演唱会&lt;/b&gt;：场馆×3.5，客源×7~17，散场脉冲×1.1" vertex="1"><mxGeometry height="22" width="280" x="1020" y="152" as="geometry" /></mxCell>
        <mxCell id="C4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ed7d31;fontSize=9;align=left;spacingLeft=4;" value="&lt;b&gt;美网（14天）&lt;/b&gt;：客源×7~17，日夜双脉冲，距离+41%" vertex="1"><mxGeometry height="22" width="280" x="1020" y="178" as="geometry" /></mxCell>
        <mxCell id="C4c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ed7d31;fontSize=9;align=left;spacingLeft=4;" value="&lt;b&gt;跨年&lt;/b&gt;：封街×0.004 冻结 → 凌晨×3.0 释放" vertex="1"><mxGeometry height="22" width="280" x="1020" y="204" as="geometry" /></mxCell>
        <mxCell id="C4d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ed7d31;fontSize=9;align=left;spacingLeft=4;" value="&lt;b&gt;马拉松&lt;/b&gt;：沿线×0.5（16区域跌超30%），全市−15%" vertex="1"><mxGeometry height="22" width="280" x="1020" y="230" as="geometry" /></mxCell>
        <mxCell id="C4e" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;align=left;spacingLeft=4;dashed=1;" value="&lt;b&gt;崩溃档（郑州7·20型）&lt;/b&gt;：总量×0.2~0.4，距离截断，空间挖洞（物理约束，未验证）" vertex="1"><mxGeometry height="34" width="280" x="1020" y="256" as="geometry" /></mxCell>

        <mxCell id="C5H" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" value="输出：λ_ext(时,区域)" vertex="1">
          <mxGeometry height="30" width="280" x="1340" y="118" as="geometry" />
        </mxCell>
        <mxCell id="C5a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#70AD47;fontSize=10;align=left;spacingLeft=6;" value="&lt;b&gt;λ_ext(t,s) =&lt;/b&gt;&lt;br&gt;基线 λ₀(日型,t,s)&lt;br&gt;× 全局剂量 (1+θg·ln(1+r/RCg))&lt;br&gt;× γ(时段,日型) 查表&lt;br&gt;× 事件乘子（如有）" vertex="1">
          <mxGeometry height="80" width="280" x="1340" y="152" as="geometry" />
        </mxCell>
        <mxCell id="C5b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#70AD47;fontSize=10;align=left;spacingLeft=6;" value="&lt;b&gt;同口径其余量&lt;/b&gt;&lt;br&gt;距离：3旋钮（μ1/w1/w3）&lt;br&gt;速度：×exp(−δv(r))，σ0=0.44&lt;br&gt;转 Step 3 采样" vertex="1">
          <mxGeometry height="80" width="280" x="1340" y="238" as="geometry" />
        </mxCell>

        <mxCell id="VBOX" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" value="&lt;b&gt;验证闭环&lt;/b&gt;：分层模型外推 MAE=10.7pp &amp;lt; 自然波动 13.9pp（达到可预测极限）&lt;br&gt;单变量 11.9pp ｜ 多维回归 14.9pp（弃用）｜ 距离 KS=0.024 ｜ 强雨外推偏差 4%" vertex="1">
          <mxGeometry height="46" width="1690" x="30" y="340" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="C1H" target="C2H" style="rounded=1;html=1;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="编码">
