        <mxCell id="T3R1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=8.5;align=center;" value="0.42｜1.52｜1.34｜1.22｜0.72" vertex="1"><mxGeometry height="16" width="230" x="750" y="206" as="geometry" /></mxCell>
