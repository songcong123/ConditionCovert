        <mxCell id="C2b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" value="&lt;b&gt;第二层 直读γ（无拟合误差）&lt;/b&gt;&lt;br&gt;γ = 各格实测均值 ÷ 全局公式预测值&lt;br&gt;共 10 个数（5时段×2日型），逐格直读" vertex="1">
          <mxGeometry height="46" width="280" x="360" y="238" as="geometry" />
        </mxCell>
        <mxCell id="C2c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#ed7d31;fontSize=10;align=left;spacingLeft=6;dashed=1;" value="⚠️ 已弃用：分时段 θs 回归拟合&lt;br&gt;（轻中雨段样本不足，斜率噪声大，MAE 14.9pp 反升）" vertex="1">
          <mxGeometry height="40" width="280" x="360" y="288" as="geometry" />
        </mxCell>

