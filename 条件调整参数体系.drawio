        <mxCell id="C2core" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontStyle=1;align=center;" value="效应 = θg × ln(1+r/RCg) × γ(s,d)" vertex="1">
