        <mxCell id="C2H" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" value="分层公式（第一层全局 × 第二层直读γ）" vertex="1">
