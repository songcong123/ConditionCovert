        <mxCell id="TITLE" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" value="条件调整参数体系：特征向量 → 分层公式 → γ 查表 → 三套日型 → 事件查表" vertex="1">
