        <mxCell id="C2a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=6;" value="&lt;b&gt;第一层 全局剂量&lt;/b&gt;：θg=0.023, RCg=0.02&lt;br&gt;365 个轻中雨样本拟合 2 个系数（最稳）" vertex="1">
