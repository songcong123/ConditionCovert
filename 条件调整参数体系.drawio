        <mxCell id="LEG" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=10;align=left;spacingLeft=6;" value="&lt;b&gt;γ 表用法&lt;/b&gt;：γ&amp;gt;1 → 该时段雨效应比平均强（放大）；γ&amp;lt;1 → 比平均弱（收缩）；γ≈1 → 与平均相同&lt;br&gt;所有 γ 来自实测直读（各格均值÷全局预测），无拟合误差；周末格样本不足时用全局比值 1.35 兜底" vertex="1">
          <mxGeometry height="42" width="1690" x="30" y="390" as="geometry" />
        </mxCell>
