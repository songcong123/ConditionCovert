        <mxCell id="M2c" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=9;fillColor=#ffffff;strokeColor=none;" value="事件：点汇聚 ×7~17（红点）&lt;br&gt;线冻结 −31~−48%（红线）" vertex="1">
