        <mxCell id="RT2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#c00000;strokeColor=#c00000;" value="" vertex="1"><mxGeometry height="15" width="3" x="1481" y="671" as="geometry" /></mxCell>
