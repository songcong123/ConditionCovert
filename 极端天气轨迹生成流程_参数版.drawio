        <mxCell id="PCAP" parent="1" style="text;html=1;align=center;verticalAlign=top;fontSize=9;fillColor=#ffffff;strokeColor=none;" value="P₀(d) 四分量：短峰＋机场鼓包（橙）＋幂尾" vertex="1">
